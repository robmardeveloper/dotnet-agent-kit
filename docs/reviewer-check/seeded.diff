+    private static async Task<Results<Ok<List<UpcomingBookingResponse>>, BadRequest>> ListUpcomingBookings(
+        string userId,
+        int? days,
+        ClaimsPrincipal user,
+        ListUpcomingBookingsHandler handler,
+        TimeProvider timeProvider,
+        CancellationToken cancellationToken)
+    {
+        if (days is < 1 || days > Booking.MaxBookingAhead.Days)
+        {
+            return TypedResults.BadRequest();
+        }
+
+        var query = new ListUpcomingBookingsQuery(UserId.Create(userId), user.FindFirstValue(ClaimTypes.Email), days);
+        var upcoming = await handler.HandleAsync(query, cancellationToken);
+
+        var now = timeProvider.GetUtcNow();
+        return TypedResults.Ok(upcoming
+            .Select(b => new UpcomingBookingResponse(
+                b.BookingId, b.CourtId, b.Start, b.End, CanCancelForFree: b.Start - now >= TimeSpan.FromHours(24)))
+            .ToList());
+    }
 }
