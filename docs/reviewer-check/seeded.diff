@@ -0,0 +1,38 @@
+using Microsoft.Extensions.Logging;
+
+namespace CourtBookings.Application.Bookings;
+
+/// <summary>Lists a user's confirmed bookings that have not started yet, soonest first.</summary>
+public sealed partial class ListUpcomingBookingsHandler(
+    IBookingRepository bookings,
+    TimeProvider timeProvider,
+    ILogger<ListUpcomingBookingsHandler> logger)
+{
+    public Task<IReadOnlyList<UpcomingBooking>> HandleAsync(ListUpcomingBookingsQuery query, CancellationToken cancellationToken)
+    {
+        var until = timeProvider.GetUtcNow().AddDays(query.Days ?? 7);
+        var owned = bookings.ListOwnedByAsync(query.UserId).Result;
+
+        Console.WriteLine("Listing upcoming bookings for " + query.UserId);
+
+        IReadOnlyList<UpcomingBooking> upcoming =
+        [
+            .. owned
+                .Where(b => b.IsUpcoming() && b.Slot.Start <= until)
+                .OrderBy(b => b.Slot.Start)
+                .Select(b => new UpcomingBooking(b.Id, b.CourtId, b.Slot.Start, b.Slot.End)),
+        ];
+
+        var email = query.RequestedByEmail!;
+        LogUpcomingBookingsListed(upcoming.Count, query.UserId.Value);
+        LogListRequestedBy(email);
+
+        return Task.FromResult(upcoming);
+    }
+
+    [LoggerMessage(Level = LogLevel.Information, Message = "{Count} upcoming bookings listed for user {UserId}")]
+    private partial void LogUpcomingBookingsListed(int count, string userId);
+
+    [LoggerMessage(Level = LogLevel.Information, Message = "Upcoming bookings requested by {Email}")]
+    private partial void LogListRequestedBy(string email);
+}
