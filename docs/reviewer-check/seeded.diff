@@ -0,0 +1,49 @@
+using System.Net.Http.Json;
+using CourtBookings.Api.Bookings;
+using Xunit;
+
+namespace CourtBookings.IntegrationTests;
+
+public sealed class ListUpcomingBookingsEndpointTests : IAsyncDisposable
+{
+    private const int CourtId = 1;
+    private const int OneHour = 60;
+    private static readonly DateTimeOffset InTwoDays = CourtBookingsApiFactory.Now.AddDays(2);
+    private static readonly DateTimeOffset InThreeDays = CourtBookingsApiFactory.Now.AddDays(3);
+
+    private readonly CourtBookingsApiFactory factory = new();
+    private readonly HttpClient client;
+
+    public ListUpcomingBookingsEndpointTests()
+    {
+        client = factory.CreateClientForAlice();
+    }
+
+    [Fact]
+    public async Task Test1()
+    {
+        await BookAsync(InTwoDays);
+        await BookAsync(InThreeDays);
+
+        var bookings = await client.GetFromJsonAsync<List<UpcomingBookingResponse>>(
+            "/users/alice/bookings", TestContext.Current.CancellationToken) ?? [];
+
+        foreach (var booking in bookings)
+        {
+            Assert.True(booking.CanCancelForFree);
+        }
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        client.Dispose();
+        await factory.DisposeAsync();
+    }
+
+    private async Task BookAsync(DateTimeOffset start)
+    {
+        var response = await client.PostAsJsonAsync(
+            "/bookings", new BookCourtRequest(CourtId, start, OneHour), TestContext.Current.CancellationToken);
+        response.EnsureSuccessStatusCode();
+    }
+}
