<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Only names the folder outside the repository where User Secrets live (SEC-1); it is not a secret.
         "dotnet user-jwts" keeps its signing key there. -->
    <UserSecretsId>bc606d14-e708-449c-a13a-f80a35557bdb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CourtBookings.Application\CourtBookings.Application.csproj" />
    <!-- Only for the composition root (DI-5): Program.cs wires Infrastructure in. -->
    <ProjectReference Include="..\CourtBookings.Infrastructure\CourtBookings.Infrastructure.csproj" />
  </ItemGroup>

</Project>
